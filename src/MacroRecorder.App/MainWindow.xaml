<Window x:Class="MacroRecorder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Macro Recorder" Height="720" Width="1100">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Start Recording" Command="{Binding StartRecordingCommand}" Margin="0,0,8,0" Padding="14,6"/>
            <Button Content="Stop Recording" Command="{Binding StopRecordingCommand}" Margin="0,0,8,0" Padding="14,6"/>
            <Button Content="Undo" Command="{Binding UndoCommand}" Margin="0,0,8,0" Padding="14,6"/>
            <Button Content="Redo" Command="{Binding RedoCommand}" Margin="0,0,8,0" Padding="14,6"/>
            <Button Content="Toggle Relative/Absolute" Command="{Binding ToggleModeCommand}" Padding="14,6"/>
        </StackPanel>

        <Border Grid.Row="1" BorderThickness="1" BorderBrush="#CCC" Padding="8" Margin="0,0,0,8" CornerRadius="4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Status: " FontWeight="Bold" />
                <TextBlock Text="{Binding Status}" Margin="0,0,14,0" />
                <TextBlock Text="Edit Mode: " FontWeight="Bold" />
                <TextBlock Text="{Binding EditModeLabel}" Margin="0,0,14,0" />
                <TextBlock Text="Actions: " FontWeight="Bold" />
                <TextBlock Text="{Binding ActionCount}" />
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Actions}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="All"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Action Id" Binding="{Binding ActionId}" Width="2*" />
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*" />
                <DataGridTextColumn Header="Offset (ticks)" Binding="{Binding TimeOffsetTicks}" Width="*" />
                <DataGridTextColumn Header="Duration (ticks)" Binding="{Binding DurationTicks}" Width="*" />
                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Margin="0,8,0,0" Foreground="#666" TextWrapping="Wrap">
            This UI is a direct testing scaffold. It captures global mouse/keyboard hooks, appends actions to the timeline,
            and exposes default Relative mode plus optional Absolute mode.
        </TextBlock>
    </Grid>
</Window>
